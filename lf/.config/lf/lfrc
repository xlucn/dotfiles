# UI options
set mouse
set drawbox false
set icons
set hidden
set info custom:size
# set a large offset to center the cursor
set scrolloff 99
set errorfmt "\033[31m%s\033[0m"

# pass arguments with delimiter '\n'
set ifs "\n"
set filesep "\n"
set previewer lf-pv

# key mapping
map <esc> cmd-escape
map <c-y> up
map <c-e> down
map <m-up> up
map <m-down> down
map gh cd ~
map gr cd /
map D delete
map zp set preview!
map <enter> open
# shell mappings
map e $$EDITOR $fx
map M push $mkdir<space>
map R $bulk-rename
map t $tig -C $PWD

cmd open $lf-open $fx
