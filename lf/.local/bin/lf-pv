#!/bin/sh
# Handle by extension
case ${1##*.} in
    # Archive
    a|ace|alz|apk|arc|arj|bz|bz2|cab|cpio|deb|gz|iso|jar|lha|lz|lzh|lzma|lzo|\
    rpm|rz|t7z|tar|tbz|tbz2|tgz|tlz|txz|tZ|tzo|war|xpi|xz|Z|zip|zst)
        bsdtar --list --file "$1"; exit ;;
    rar)
        unrar lt -p- -- "$1"; exit ;;
    7z)
        7z l -p -- "$1"; exit ;;

    # PDF
    pdf) # Convert pdf file to texts
        pdfinfo "$1"; pdftotext -l 5 -nopgbrk -q -- "$1" -; exit ;;

    djvu)
        djvutxt -page=1-5 "$1"; exit ;;

    # BitTorrent
    torrent)
        transmission-show -- "$1"; exit ;;

    # OpenDocument
    odt|ods|odp|sxw) # Preview as text conversion
        odt2txt "$1"; exit ;;

    # HTML
    htm|html|xhtml)
        # Preview as text conversion
        elinks -dump "$1" ||
        lynx -dump -- "$1" ||
        w3m -dump "$1"; exit ;;

    *) ;; # Go on to handle by mime type
esac

# Handle by mime types
case "$(file -Lb --mime-type -- "$1")" in
    # Text
    text/*|*/xml|*/csv|*/json)
        if command -v highlight > /dev/null 2>&1; then
            highlight -O ansi --line-range=1-100 --force "$1"
        else
            head -n100 "$1"
        fi
        exit ;;

    # Image
    image/*)
        # --work=1 will make it the fastest
        # --view-size=wxh will not scale up small images (--size=wxh will)
        chafa --polite=on --animate=off \
            --format=sixels --view-size="$2x$3" "$1"
        exit ;;

    # Video and audio
    video/*|audio/*)
        # pipe through column just to compact the output
        mediainfo --Output=CSV "$1" | column -t -s ','; exit ;;

    *) ;; # Go on to fall back
esac

# None of above exits, this is the fall back
echo '----- File Type Classification -----'
file --dereference --brief -- "$1"
