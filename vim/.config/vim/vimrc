" be Vi if started as vi, ex, edit, view, etc.
if v:progname =~? '^\(vi\|view\|ex\|edit\)$'
    set compatible
    so $HOME/.config/ex/exrc
    finish
endif
" be Vi IMproved, put this line at TOP of vimrc
set nocompatible
" XDG Base Directories
set runtimepath^=$HOME/.config/vim
set packpath^=$HOME/.local/share/vim
set directory=$HOME/.cache/vim/swap
set viminfo+=n$HOME/.cache/vim/viminfo
set backupdir=$HOME/.cache/vim/backup
" detect filetype and apply syntax highlighting
syntax on
filetype on
filetype plugin on
filetype indent on

so $HOME/.config/vim/common.vim
set autoindent
set autoread " auto reload files
set encoding=utf-8
set hidden
set incsearch
set hlsearch
" UI
set termguicolors
set background=dark     " color scheme
set belloff=all         " don't beep
set display+=lastline   " show partial line
set laststatus=2        " show status line
set ttimeoutlen=50      " do not wait too long after escape key
set wildmenu            " turn on wild menu on :e <Tab>
set mouse=a             " enable mouse support in console
set ttymouse=sgr
if has("gui_running")
    set guicursor+=a:blinkon0  " don't blink the cursor
    set guioptions=cd          " minimal gui options
    set guifont=monospace\ 11  " initialize the font for the setup below
    " Zoom in/out with Ctrl + Mouse Wheel
    nnoremap <C-ScrollWheelUp> :silent! let &guifont = substitute(&guifont,
                \'\s\zs\d\+', '\=eval(submatch(0)+1)', '')<CR>
    nnoremap <C-ScrollWheelDown> :silent! let &guifont = substitute(&guifont,
                \'\s\zs\d\+', '\=eval(submatch(0)-1)', '')<CR>
endif

noremap <leader>r <CMD>so $HOME/.config/vim/vimrc<CR>
" Navigation
nnoremap <silent> <C-P> <CMD>cprevious<CR>
nnoremap <silent> <C-N> <CMD>cnext<CR>
nnoremap <silent> [l <CMD>lprevious<CR>
nnoremap <silent> ]l <CMD>lnext<CR>
" cursor shape for terminal emulators or linux console
if has("gui_running") == 0
    if $TERM != "linux"
        let &t_SI = "\e[6 q"  " sent when entering insert mode
        let &t_SR = "\e[4 q"  " sent when entering replace mode
        let &t_EI = "\e[2 q"  " sent when leaving insert or replace mode
    else  " for Linux tty
        let &t_ve = "\e[?25h"
        let &t_vi = "\e[?25l"
        let &t_SI = "\e[?0c"
        let &t_SR = "\e[?4c"
        let &t_EI = "\e[?8c"
    endif
endif
" built-in plugins or file type supports {{{
let g:termdebug_wide=1
let g:tex_flavor = "latex"
" }}}
