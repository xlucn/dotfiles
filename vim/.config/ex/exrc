" exrc, ex/vi init file
"
" Note:
" 1. Comment starts with ".
" 2. NO empty lines! Use empty comment if needed.
"
" References:
" https://heather.cs.ucdavis.edu/~matloff/UnixAndC/Editors/ViIntro.html
" https://hea-www.harvard.edu/~fine/Tech/vi.html
"
""""""""""""""
" Vi Options "
""""""""""""""
" Automatically indent on the next line
set autoindent
" Auto save file after leaving the buffer
set autowrite
" Put buffer files in /tmp
set directory=/tmp
" Don't flash
set noflash
" Ignore case when searching
set ignorecase
" Show tab as ^I, EOL as $, literally. It's not good looking.
set nolist
" Modelines, search for 'vi:' for commands
set modelines
" Show line number, Arch Linux's package has a fix patch
set number
" Do repeat mapping, some complicated macros may need this
set remap
" Show messsage for edits exceeds this number of lines
set report=1
" Use bash for :shell command
set shell=/bin/bash
" Indent 4 spaces with autoindent, >> or <<
set shiftwidth=4
" Highlight the matching () {} when closing it.
set showmatch
" Show mode change
set showmode
" Tab 4 spaces
set tabstop=4
" Do not wait 1 second for keymap to complete.
" Instant escape if there aren't keymappings start with escape(^[).
" However escape would wait indefinitely if there are any such maps.
set notimeout
"
""""""""""""
" Mappings "
""""""""""""
"
" Mappings to quit, edit, save and more.
map g :1
map ,q :q
map ,z :q!
map ,e :e
map ,w :w
map ,x :wq
"
" Delete inside "/'/()/[]/{}
map " T"dt"
map ' T'dt'
map ) T(dt)
map ] T[dt]
map } T{dt}
" Surround word with "/'/()/[]/{}
map " ebi"ea"
map ' ebi'ea'
map ) ebi(ea)
map ] ebi[ea]
map } ebi{ea}
" Delete surrounding "/'/()/[]/{}
map " F"xf"x
map ' F'xf'x
map ) F(xf)x
map ] F[xf]x
map } F{xf}x
"
" Toggle settings
map [n :set nu
map ]n :set nonu
map [w :set wrapscan
map ]w :set nowrapscan
"
" Complete words, famous vi macros, modified from original below
map!  a.hbmmi?\<2h"zdt.@zywmx`mPlxa
map!  a.hbmmi/\<2h"zdt.@zywmx`mPlxa
" https://heather.cs.ucdavis.edu/~matloff/UnixAndC/Editors/ViIntro.html#tth_sEc4.1
" map!  a. hbmmi?\<2h"zdt.@zywmx`mP xi
" map!  a. hbmmi/\<2h"zdt.@zywmx`mP xi
"
" Join lines in a paragraph
" Modified from https://hea-www.harvard.edu/~fine/Tech/vi.html
map V 0ma}b:'a,.j}j
"
" Format mapping from https://hea-www.harvard.edu/~fine/Tech/vi.html
" This will join the rest of the paragraph, break the line at the 72th column.
" You should keep pressing the key to format the whole paragraph.
map v 0ma}b:'a,.j072 ?  *dwi
"
" Execute current line
" Vi doesn't have command history, this can be used to try and modify commands
map  "ayy:@a
"
"""""""""""""""""
" Abbreviations "
"""""""""""""""""
" Insert date
" https://web.archive.org/http://soma.npa.uiuc.edu/docs/vi.macros
abbr dater :.!date +\%FkJA
abbr timer :.!date +\%TkJA
abbr datetimer :.!date +\%FT\%TkJA
"
" vim: syntax=vim commentstring=\"\ %s
