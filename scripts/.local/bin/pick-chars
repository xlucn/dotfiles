#!/usr/bin/env python
"""Choose and copy characters given a font name or file."""

import os
import sys
from subprocess import CalledProcessError, check_output

import pyperclip
from fontTools.ttLib import TTFont
from fontTools.unicode import Unicode

if len(sys.argv) != 2:
    exit(1)
elif os.path.exists(sys.argv[1]):
    font_file = sys.argv[1]
else:
    font_name = sys.argv[1]
    font_file = check_output(
        ["/bin/fc-match", font_name, "--format='%{{file}}"],
        text=True,
    )
if not os.path.exists(font_file):
    exit(1)

lines = []
with TTFont(font_file) as ttf:
    cmap = ttf.getBestCmap()
    if cmap is None:
        print(f"No cmap found in font file: {font_file}")
        exit(1)
    for y in cmap:
        c = chr(y)
        if y <= 32 or y == 127:
            continue

        desc = Unicode[y].lower() if cmap[y].startswith("uni") else cmap[y]
        lines.append(f"{c} {y:05x} {desc}")

try:
    choice = check_output(
        ["/bin/fzf", "--prompt", "Choose a glyph: ", "--multi"],
        text=True,
        input="\n".join(lines),
    )
except CalledProcessError:
    exit(1)

glyphs = " ".join(
    [chr(int(line.split()[1], base=16)) for line in choice.split("\n")[:-1]],
)
pyperclip.copy(bytes(glyphs, encoding="utf-8"))
