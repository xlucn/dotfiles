# This is Git's per-user configuration file.
[init]
    defaultBranch = main
[user]
    name = Lu Xu
    email = oliver_lew@outlook.com
[core]
    pager = "less -x1,5 --mouse --wheel-lines=3"
    filemode = true
[gui]
    spellingdictionary = none
[alias]
    ls = ls-tree --name-only -r
    s = status
    c = commit -m
    l = log
    b = branch
    pl = log --all --decorate --oneline --graph --date-order
    as = autostats # my own script
; [http]
;     proxy = "socks5://127.0.0.1:1081"
[pull]
    rebase = false
[merge]
    tool = nvimdiff
[commit]
    verbose = true

[tig]
    mouse = true
    tab-size = 4
    wrap-lines = false
    main-view-date = custom
    main-view-date-format = "%Y-%m-%d"
    main-view-author-display = abbreviated
    main-view-author-maxwidth = 10
[tig "bind"]
    generic = g move-first-line
    generic = G move-last-line
    generic = <Ctrl-b> move-page-up
    generic = <Ctrl-f> move-page-down
    generic = D :toggle word-diff
    main = g move-first-line
    main = G move-last-line
    main = e !git commit --amend
[tig "color"]
    cursor = black green bold
    cursor-blur = black green bold
    title-focus = black blue bold
    title-blur = black blue bold
